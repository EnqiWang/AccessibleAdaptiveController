(version 1)
(rule "Bantam clearance"
  (constraint clearance (min 0.1524mm)))
(rule "Bantam track width"
  (constraint track_width (min 0.1524mm)))
(rule "Bantam annular ring"
  (constraint annular_width (min 0.254mm)))
(rule "Bantam min hole"
  (constraint hole_size (min 0.8mm)))
(rule "Bantam hole to hole"
  (constraint hole_to_hole (min 0.1524mm)))